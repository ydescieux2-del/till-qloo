# Copy to .env (gitignored). Every value is optional.
# Qloo hackathon key. Without it Till runs in MOCK mode on synthetic, clearly labeled demo data.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# With a Claude key, Claude picks and chains Till's tools in the demo page; without one, a keyword router does.
ANTHROPIC_API_KEY=
TILL_AGENT_MODEL=claude-haiku-5-5
PORT=8765
# Optional. Speak answers in an ElevenLabs voice (falls back to the browser voice).
ELEVENLABS_API_KEY=
TILL_VOICE_ID=
